		{
			"label": "find-ng-select-for-angular20",
			"type": "shell",
			"command": "$versions = npm.cmd view @ng-select/ng-select versions --json | ConvertFrom-Json; $match = @(); foreach ($v in $versions) { $peer = npm.cmd view @ng-select/ng-select@$v peerDependencies --json 2>$null; if ($peer) { $obj = $peer | ConvertFrom-Json; if ($obj.'@angular/core' -like '^20*' -or $obj.'@angular/core' -like '>=20*' -or $obj.'@angular/core' -like '*20*') { $match += [PSCustomObject]@{version=$v; core=$obj.'@angular/core'; common=$obj.'@angular/common'; forms=$obj.'@angular/forms'} } } }; $match | Select-Object -Last 10 | Format-Table -AutoSize | Out-String"
		},
		{
			"label": "ng-select-major-peer-check",
			"type": "shell",
			"command": "$majors = 14..23; foreach ($m in $majors) { $v = npm.cmd view @ng-select/ng-select@$m version 2>$null; if ($LASTEXITCODE -eq 0 -and $v) { $p = npm.cmd view @ng-select/ng-select@$m peerDependencies --json 2>$null; Write-Output \"major $m => version $v\"; Write-Output $p } }"
		},
